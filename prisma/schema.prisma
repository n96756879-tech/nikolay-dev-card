generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  email       String?
  github      String?
  linkedin    String?
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id          Int     @id @default(autoincrement())
  company     String?
  position    String?
  period      String?
  description String?
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  url         String?
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
